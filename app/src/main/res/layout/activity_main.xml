<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:clipToPadding="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KINLINK"
                    android:textColor="#0B57D0"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Pilotage continu · preuve locale"
                    android:textColor="#667085"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="KINLINK"
                android:textColor="#98A2B3"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_primary"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/heroEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/status_pill"
                android:paddingStart="9dp"
                android:paddingTop="4dp"
                android:paddingEnd="9dp"
                android:paddingBottom="4dp"
                android:text="AUTOPILOT"
                android:textColor="#EAF2FF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Vérification de la connexion"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroDetailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="3"
                android:text="KINLINK observe sans consommer de données de test."
                android:textColor="#DCE9FF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="ÉTAT ACTUEL"
            android:textColor="#667085"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/card_neutral"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:id="@+id/transportText"
                style="@style/KinlinkSummaryText"
                android:text="Connexion" />

            <TextView
                android:id="@+id/internetText"
                style="@style/KinlinkSummaryText"
                android:layout_marginTop="8dp"
                android:text="Internet" />

            <TextView
                android:id="@+id/mobileText"
                style="@style/KinlinkSummaryText"
                android:layout_marginTop="8dp"
                android:text="Protection mobile" />

            <TextView
                android:id="@+id/qualityScoreText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Qualité passive · --/100"
                android:textColor="#123B78"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/qualityProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/mobileBudgetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:text="Suivi mobile · initialisation"
                android:textColor="#667085"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/reliabilityText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="3"
                android:text="24 h · historique en préparation"
                android:textColor="#475467"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_soft_blue"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:id="@+id/adviceTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilotage continu"
                android:textColor="#123B78"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/adviceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Surveillance active. KINLINK agit seulement si le bénéfice peut être vérifié."
                android:textColor="#365B91"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/wifiDoctorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_outline"
            android:gravity="center"
            android:padding="12dp"
            android:text="Assistance Wi‑Fi"
            android:textColor="#0B57D0"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mobileAssistButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_outline"
            android:gravity="center"
            android:padding="12dp"
            android:text="Assistant mobile"
            android:textColor="#0B57D0"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/profileButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/button_outline"
                android:gravity="center"
                android:minHeight="54dp"
                android:padding="9dp"
                android:text="Profil · Équilibré"
                android:textColor="#0B57D0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/safeModeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/button_outline"
                android:gravity="center"
                android:minHeight="54dp"
                android:padding="9dp"
                android:text="Mode sûr · OFF"
                android:textColor="#0B57D0"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/budgetButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/button_outline"
                android:gravity="center"
                android:minHeight="54dp"
                android:padding="9dp"
                android:text="Protection data"
                android:textColor="#0B57D0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/incidentMarkerButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/button_outline"
                android:gravity="center"
                android:minHeight="54dp"
                android:padding="9dp"
                android:text="Marquer un problème"
                android:textColor="#0B57D0"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/technicalToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_outline"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="9dp"
            android:text="Détails techniques"
            android:textColor="#0B57D0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_neutral"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:textColor="#344054"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/diagnosticExport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_outline"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="9dp"
            android:text="Exporter le diagnostic"
            android:textColor="#0B57D0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
