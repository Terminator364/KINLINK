<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:clipToPadding="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <!-- Responsive header: deliberately vertical so version text can never
             steal width from the product name on narrow phones. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KINLINK"
            android:textColor="#0B57D0"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Pilotage continu · preuve locale"
            android:textColor="#667085"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2"
            android:text="KINLINK"
            android:textColor="#98A2B3"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_primary"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/heroEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/status_pill"
                android:paddingStart="9dp"
                android:paddingTop="4dp"
                android:paddingEnd="9dp"
                android:paddingBottom="4dp"
                android:text="AUTOPILOT"
                android:textColor="#EAF2FF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Vérification de la connexion"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroDetailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="3"
                android:text="Connexion en cours d’analyse."
                android:textColor="#DCE9FF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="ÉTAT ACTUEL"
            android:textColor="#667085"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/card_neutral"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:id="@+id/transportText"
                style="@style/KinlinkSummaryText"
                android:text="Réseau" />

            <TextView
                android:id="@+id/internetText"
                style="@style/KinlinkSummaryText"
                android:layout_marginTop="6dp"
                android:text="Internet" />

            <TextView
                android:id="@+id/mobileText"
                style="@style/KinlinkSummaryText"
                android:layout_marginTop="6dp"
                android:text="Protection mobile" />

            <TextView
                android:id="@+id/qualityScoreText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Qualité passive · --/100"
                android:textColor="#123B78"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/qualityProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/mobileBudgetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:maxLines="2"
                android:text="Data mobile · initialisation"
                android:textColor="#667085"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/reliabilityText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="3"
                android:text="24 h · historique en préparation"
                android:textColor="#475467"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="BOUCLE DE CONTRÔLE"
            android:textColor="#667085"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/card_soft_blue"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:id="@+id/adviceTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Surveillance"
                android:textColor="#123B78"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/adviceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="KINLINK observe et agit seulement sous ses garde-fous."
                android:textColor="#365B91"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AVANT"
                        android:textColor="#667085"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/beforeScoreText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—"
                        android:textColor="#123B78"
                        android:textSize="23sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MAINTENANT"
                        android:textColor="#667085"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/nowScoreText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—"
                        android:textColor="#123B78"
                        android:textSize="23sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ÉCART"
                        android:textColor="#667085"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/deltaScoreText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—"
                        android:textColor="#123B78"
                        android:textSize="23sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/maintainedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Maintien · en attente de preuve"
                android:textColor="#365B91"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/evidenceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Historique de bénéfice · en collecte"
                android:textColor="#475467"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/wifiDoctorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_outline"
            android:gravity="center"
            android:minHeight="54dp"
            android:padding="12dp"
            android:text="Assistance Wi‑Fi"
            android:textColor="#0B57D0"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mobileAssistButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_outline"
            android:gravity="center"
            android:minHeight="54dp"
            android:padding="12dp"
            android:text="Réévaluer maintenant"
            android:textColor="#0B57D0"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/profileButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/button_outline"
                android:gravity="center"
                android:minHeight="52dp"
                android:padding="8dp"
                android:text="Profil · Équilibré"
                android:textColor="#0B57D0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/safeModeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/button_outline"
                android:gravity="center"
                android:minHeight="52dp"
                android:padding="8dp"
                android:text="Mode sûr · OFF"
                android:textColor="#0B57D0"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/budgetButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/button_outline"
                android:gravity="center"
                android:minHeight="52dp"
                android:padding="8dp"
                android:text="Protection data"
                android:textColor="#0B57D0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/incidentMarkerButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/button_outline"
                android:gravity="center"
                android:minHeight="52dp"
                android:padding="8dp"
                android:text="Signaler un problème"
                android:textColor="#0B57D0"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/technicalToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:background="@drawable/button_outline"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="9dp"
            android:text="Détails techniques"
            android:textColor="#0B57D0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_neutral"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:textColor="#344054"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/diagnosticExport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_outline"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="9dp"
            android:text="Exporter le diagnostic"
            android:textColor="#0B57D0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
